    "scripts/**",
    "requirements-ci.txt",
    ".github/workflows/**",
    ".gitattributes",
    "conftest.py",
    "tests/conftest.py",
    "tests/__init__.py",
    "pytest.ini",
    "pyproject.toml",
    "setup.cfg",
    "tox.ini"
  ],
