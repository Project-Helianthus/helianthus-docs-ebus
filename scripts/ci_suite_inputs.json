{
  "version": 1,
  "description": "Inputs of the heavy Docs Checks suites. A same-repository pull request skips a suite only when no file matched by shared_inputs or by the suite's inputs differs between the trusted base checkout and the pull-request head. Main pushes, the nightly run, manual dispatches and fork pull requests run every suite. Patterns are repository-relative POSIX paths: a plain path names one file, a trailing /** names a directory tree, and *, ? and [] are shell-style wildcards that may also match a slash. The lists were derived by tracing every file each suite opens, lists or globs while it runs (Python audit hooks, child processes included), then widened to whole directories where a suite enumerates them.",
  "shared_inputs": [
    "scripts/**",
    "requirements-ci.txt",
    ".github/workflows/**",
    ".gitattributes",
    "conftest.py",
    "tests/conftest.py",
    "tests/__init__.py",
    "pytest.ini",
    "pyproject.toml",
    "setup.cfg",
    "tox.ini"
  ],
  "suites": {
    "graphql_face_provenance": {
      "inputs": [
        "tests/test_graphql_face_provenance_checker.py",
        "scripts/check_graphql_face_provenance.py",
        "architecture/atr/07-live-validation-acceptance.md"
      ]
    },
    "b503_milestones": {
      "inputs": [
        "tests/test_vaillant_b503_milestone_checker.py",
        "scripts/check_vaillant_b503_milestones.py",
        "architecture/protocol-routing-vaillant-b503.md"
      ]
    },
    "basv0_profile": {
      "inputs": [
        "tests/test_b524_basv0_description_profile.py",
        "tests/test_b524_calendar_edge_vectors.py",
        "tests/test_b524_description_schema_privacy.py",
        "tests/test_b524_exp_nonfinite_limits.py",
        "tests/test_b524_evidence_join_permutations.py",
        "tests/test_b524_external_bundle_cli.py",
        "tests/test_b524_cli_input_errors.py",
        "tests/test_b524_overlay_cli_rejection.py",
        "tests/test_b524_bounded_survey_profile.py",
        "scripts/validate_b524_basv0_description_profile.py",
        "scripts/validate_b524_bounded_survey_profile.py",
        "scripts/ci_local.sh",
        "protocols/vaillant/ebus-vaillant-b524-register-map.md",
        "protocols/vaillant/ebus-vaillant-b524-basv0-profile-v1.md",
        "protocols/vaillant/ebus-vaillant-b524-survey-*.md",
        "protocols/vaillant/fixtures/b524-basv0-*",
        "protocols/vaillant/fixtures/b524-bounded-survey-*",
        "protocols/vaillant/fixtures/b524-op02-*",
        "development/fixtures/b524-basv0-*"
      ]
    },
    "modbus_companion": {
      "inputs": [
        "tests/test_modbus_companion_contract.py",
        "tests/test_modbus_trusted_revision.py",
        "tests/test_eebus_operator_admin_contract.py",
        "scripts/validate_modbus_companion.py",
        "scripts/validate_modbus_revision_transition.py",
        "scripts/ci_local.sh",
        ".github/workflows/modbus-trusted-revision.yml",
        "README.md",
        "architecture/b524-semantic-mapping.md",
        "architecture/b524-structural-decisions.md",
        "architecture/decisions.md",
        "architecture/semantic-configuration-gates.md",
        "architecture/semantic-structure-fsm-map.md",
        "development/ha-integration.md",
        "protocols/LICENSE",
        "protocols/modbus/**",
        "docs/platform/**"
      ]
    }
  }
}
