      "id": "SRC-SD05-zone-room-unit",
      "decisions": [
        "SD-05",
        "SD-15"
      ],
      "attachment": "zone_room_unit_binding",
      "published_field": "zones[].config.roomTemperatureZoneMapping",
      "from": {
        "kind": "zone_instance",
        "identity_evidence": [
          {
            "selector": "OP=0x02 GG=0x03 II=zone",
            "role": "instance_position",
            "classification": "native_position"
          },
          {
            "selector": "OP=0x02 GG=0x03 II=zone RR=0x0013",
            "role": "binding_value",
            "classification": "relation_value"
          }
        ],
        "resolution": "native"
      },
      "to": {
        "kind": "device_slot",
        "identity_evidence": [
          {
            "selector": "OP=0x06 GG=0x09/0x0A II=slot",
            "role": "instance_position",
            "classification": "native_position"
          }
        ],
        "resolution": "gateway_policy"
      },
      "evidence_grade": "Proven",
      "validity_scope": [
        "PROTOCOL"
      ],
      "disposition": "relation_candidate",
      "native_statements": [
        {
          "selector": "OP=0x02 GG=0x03 II=zone RR=0x0013",
          "source": "decision_catalog",
          "reading": "The zone states its room-unit binding as a raw value: 0 none, 1 the controller's own unit, 2 and above a room-unit number.",
          "scope": "PROTOCOL"
        }
      ],
      "reason": "The binding is a native zone value for the zone end. The step from the value to one OP=0x06 slot instance (1 to GG=0x09, 2 and above to GG=0x0A at value minus one) is gateway policy, so the room-unit end stays a gateway-policy resolution. The room-unit side value OP=0x06 GG=0x09/0x0A RR=0x0025 corroborates the binding and is no gate.",
      "pending_review": null
    },
