{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "B524 bounded survey profile v1",
  "type": "object",
  "required": [
    "schema_version",
    "evidence_class",
    "tool_identity",
    "model_scope",
    "survey_scope",
    "group_windows",
    "execution",
    "catalog_reference",
    "nonclaims",
    "samples",
    "effective_scan_windows"
  ],
  "properties": {
    "schema_version": {
      "const": "b524-bounded-survey-profile/v1"
    },
    "evidence_class": {
      "const": "sanitized_read_only_observation"
    },
    "tool_identity": {
      "type": "object",
      "required": [
        "acquisition",
        "catalog"
      ],
      "properties": {
        "acquisition": {
          "type": "object",
          "required": [
            "name",
            "version",
            "commit"
          ],
          "properties": {
            "commit": {
              "pattern": "^[0-9a-f]{40}$"
            }
          }
        },
        "catalog": {
          "type": "object",
          "required": [
            "name",
            "commit"
          ],
          "properties": {
            "commit": {
              "pattern": "^[0-9a-f]{40}$"
            }
          }
        }
      }
    },
    "model_scope": {
      "type": "object",
      "required": [
        "family",
        "model",
        "software_version",
        "hardware_version"
      ]
    },
    "survey_scope": {
      "type": "object",
      "required": [
        "read_request_layout",
        "describe_request_layout",
        "read_instance_scope",
        "describe_instance_scope"
      ]
    },
    "group_windows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "operation",
          "groups",
          "rr_window",
          "status",
          "description_coverage"
        ],
        "properties": {
          "operation": {
            "enum": [
              "OP02",
              "OP06"
            ]
          },
          "groups": {
            "type": "array",
            "minItems": 1,
            "items": {
              "pattern": "^[0-9A-F]{2}$"
            }
          },
          "rr_window": {
            "pattern": "^[0-9A-F]{4}\\.\\.[0-9A-F]{4}$"
          },
          "status": {
            "enum": [
              "positive_observed",
              "known_family_no_positive_in_this_survey",
              "unknown_group_empty_reply_only"
            ]
          }
        }
      }
    },
    "observed_describe_high_water_marks": {
      "type": "object"
    },
    "read_only_tails": {
      "type": "object"
    },
    "execution": {
      "type": "object",
      "required": [
        "planned_jobs",
        "completed_jobs",
        "final_transport_failures",
        "response_categories",
        "actual_attempts",
        "reused_completed_exchanges",
        "phases"
      ],
      "properties": {
        "planned_jobs": {
          "type": "integer",
          "minimum": 0
        },
        "completed_jobs": {
          "type": "integer",
          "minimum": 0
        },
        "final_transport_failures": {
          "type": "integer",
          "minimum": 0
        },
        "response_categories": {
          "type": "object",
          "required": [
            "value_reply",
            "empty_reply",
            "description_correlated_raw",
            "high_group_empty_reply"
          ],
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "actual_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "reused_completed_exchanges": {
          "type": "integer",
          "minimum": 0
        },
        "phases": {
          "type": "object",
          "required": [
            "discovery",
            "extension"
          ],
          "properties": {
            "discovery": {
              "$ref": "#/$defs/phase"
            },
            "extension": {
              "$ref": "#/$defs/phase"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "catalog_reference": {
      "type": "object",
      "required": [
        "path",
        "scope",
        "qualified_description_limits"
      ]
    },
    "nonclaims": {
      "type": "array",
      "minItems": 1
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "selector",
          "request_payload_hex",
          "reply_payload_hex",
          "outcome"
        ],
        "properties": {
          "outcome": {
            "enum": [
              "value_reply",
              "empty_reply",
              "transport_error",
              "decode_error",
              "unknown"
            ]
          },
          "flags_class": {
            "enum": [
              "read_only_hidden",
              "read_only_visible",
              "writable_hidden",
              "writable_visible"
            ]
          }
        }
      }
    },
    "effective_scan_windows": {
      "type": "object",
      "required": [
        "OP02",
        "OP06",
        "qualification"
      ],
      "properties": {
        "OP02": {
          "$ref": "#/$defs/operationWindows"
        },
        "OP06": {
          "$ref": "#/$defs/operationWindows"
        },
        "qualification": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "description_high_water_qualification": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "operationWindows": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[0-9A-F]{2}$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "rr_max",
          "terminal_max_established"
        ],
        "properties": {
          "rr_max": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9A-F]{4}$"
          },
          "terminal_max_established": {
            "const": false
          }
        },
        "additionalProperties": false
      }
    },
    "phase": {
      "type": "object",
      "required": [
        "planned_jobs",
        "completed_jobs",
        "actual_attempts"
      ],
      "properties": {
        "planned_jobs": {
          "type": "integer",
          "minimum": 0
        },
        "completed_jobs": {
          "type": "integer",
          "minimum": 0
        },
        "actual_attempts": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
