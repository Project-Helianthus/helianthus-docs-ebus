{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "B524 bounded survey profile v1",
  "type": "object",
  "required": [
    "schema_version",
    "evidence_class",
    "tool_identity",
    "model_scope",
    "survey_scope",
    "group_windows",
    "execution",
    "catalog_reference",
    "nonclaims",
    "samples",
    "effective_scan_windows"
  ],
  "properties": {
    "schema_version": {
      "const": "b524-bounded-survey-profile/v1"
    },
    "evidence_class": {
      "const": "sanitized_read_only_observation"
    },
    "tool_identity": {
      "type": "object",
      "required": [
        "acquisition",
        "catalog"
      ],
      "properties": {
        "acquisition": {
          "type": "object",
          "required": [
            "name",
            "version",
            "commit"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "additionalProperties": false
        },
        "catalog": {
          "type": "object",
          "required": [
            "name",
            "commit"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "model_scope": {
      "type": "object",
      "required": [
        "family",
        "model",
        "software_version",
        "hardware_version"
      ],
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "software_version": { "type": "string", "minLength": 1 },
        "hardware_version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "survey_scope": {
      "type": "object",
      "required": [
        "read_request_layout",
        "describe_request_layout",
        "read_instance_scope",
        "describe_instance_scope"
      ],
      "properties": {
        "read_request_layout": { "type": "string", "minLength": 1 },
        "describe_request_layout": { "type": "string", "minLength": 1 },
        "read_instance_scope": { "type": "string", "minLength": 1 },
        "describe_instance_scope": { "type": "string", "minLength": 1 },
        "configured_discovery_intervals": { "type": "string", "minLength": 1 },
        "exchange_context": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "group_windows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "operation",
          "groups",
          "rr_window",
          "status",
          "description_coverage"
        ],
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "OP02",
              "OP06"
            ]
          },
          "groups": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[0-9A-F]{2}$"
            }
          },
          "rr_window": {
            "type": "string",
            "pattern": "^[0-9A-F]{4}\\.\\.[0-9A-F]{4}$"
          },
          "description_coverage": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "positive_observed",
              "known_family_no_positive_in_this_survey",
              "unknown_group_empty_reply_only"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "observed_describe_high_water_marks": {
      "type": "object"
    },
    "read_only_tails": {
      "type": "object"
    },
    "execution": {
      "type": "object",
      "required": [
        "planned_jobs",
        "completed_jobs",
        "final_transport_failures",
        "response_categories",
        "actual_attempts",
        "reused_completed_exchanges",
        "phases"
      ],
      "properties": {
        "planned_jobs": {
          "type": "integer",
          "minimum": 0
        },
        "completed_jobs": {
          "type": "integer",
          "minimum": 0
        },
        "final_transport_failures": {
          "type": "integer",
          "minimum": 0
        },
        "response_categories": {
          "type": "object",
          "required": [
            "value_reply",
            "empty_reply",
            "description_correlated_raw",
            "high_group_empty_reply"
          ],
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "actual_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "reused_completed_exchanges": {
          "type": "integer",
          "minimum": 0
        },
        "phases": {
          "type": "object",
          "required": [
            "discovery",
            "extension"
          ],
          "properties": {
            "discovery": {
              "$ref": "#/$defs/phase"
            },
            "extension": {
              "$ref": "#/$defs/phase"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "catalog_reference": {
      "type": "object",
      "required": [
        "path",
        "scope",
        "qualified_description_limits"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "qualified_description_limits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/qualifiedDescriptionLimit"
          }
        }
      },
      "additionalProperties": false
    },
    "nonclaims": {
      "type": "array",
      "minItems": 1
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "selector",
          "request_payload_hex",
          "reply_payload_hex",
          "outcome"
        ],
        "properties": {
          "kind": {
            "enum": ["op02_read", "op06_read", "op07_generic_description"]
          },
          "selector": {
            "$ref": "#/$defs/selector"
          },
          "request_payload_hex": {
            "type": "string",
            "pattern": "^(?:[0-9A-Fa-f]{2})*$"
          },
          "reply_payload_hex": {
            "type": "string",
            "pattern": "^(?:[0-9A-Fa-f]{2})*$"
          },
          "outcome": {
            "enum": [
              "value_reply",
              "empty_reply",
              "transport_error",
              "decode_error",
              "unknown"
            ]
          },
          "flags_class": {
            "enum": [
              "read_only_hidden",
              "read_only_visible",
              "writable_hidden",
              "writable_visible"
            ]
          },
          "qualification": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "op02_read" } } },
            "then": { "properties": { "selector": { "properties": { "op": { "const": "02" } } } } }
          },
          {
            "if": { "properties": { "kind": { "const": "op06_read" } } },
            "then": { "properties": { "selector": { "properties": { "op": { "const": "06" } } } } }
          },
          {
            "if": { "properties": { "kind": { "const": "op07_generic_description" } } },
            "then": { "properties": { "selector": { "properties": { "op": { "const": "07" }, "ii": { "const": "FF" } } } } }
          }
        ],
        "additionalProperties": false
      }
    },
    "effective_scan_windows": {
      "type": "object",
      "required": [
        "OP02",
        "OP06",
        "qualification"
      ],
      "properties": {
        "OP02": {
          "$ref": "#/$defs/operationWindows"
        },
        "OP06": {
          "$ref": "#/$defs/operationWindows"
        },
        "qualification": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "description_high_water_qualification": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "selector": {
      "type": "object",
      "required": ["op", "gg", "ii", "rr"],
      "properties": {
        "op": { "type": "string", "pattern": "^[0-9A-F]{2}$" },
        "gg": { "type": "string", "pattern": "^[0-9A-F]{2}$" },
        "ii": { "type": "string", "pattern": "^[0-9A-F]{2}$" },
        "rr": { "type": "string", "pattern": "^[0-9A-F]{4}$" }
      },
      "additionalProperties": false
    },
    "qualifiedDescriptionLimit": {
      "type": "object",
      "required": [
        "selector",
        "semantic_name",
        "codec",
        "min",
        "max",
        "step",
        "qualification"
      ],
      "properties": {
        "selector": {
          "allOf": [
            {"$ref": "#/$defs/selector"},
            {
              "properties": {
                "op": {"const": "07"},
                "ii": {"const": "FF"}
              }
            }
          ]
        },
        "semantic_name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "codec": {
          "type": "string",
          "minLength": 1
        },
        "min": {
          "type": ["boolean", "number", "string"]
        },
        "max": {
          "type": ["boolean", "number", "string"]
        },
        "step": {
          "type": ["boolean", "number", "string"]
        },
        "qualification": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {"properties": {"codec": {"const": "BOOL"}}, "required": ["codec"]},
          "then": {
            "properties": {
              "min": {"type": "boolean"},
              "max": {"type": "boolean"},
              "step": {"type": "boolean"}
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "operationWindows": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[0-9A-F]{2}$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "rr_max",
          "terminal_max_established"
        ],
        "properties": {
          "rr_max": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9A-F]{4}$"
          },
          "terminal_max_established": {
            "const": false
          }
        },
        "additionalProperties": false
      }
    },
    "phase": {
      "type": "object",
      "required": [
        "planned_jobs",
        "completed_jobs",
        "actual_attempts"
      ],
      "properties": {
        "planned_jobs": {
          "type": "integer",
          "minimum": 0
        },
        "completed_jobs": {
          "type": "integer",
          "minimum": 0
        },
        "actual_attempts": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
