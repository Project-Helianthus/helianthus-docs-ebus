{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "B524 operation edit plan v1",
  "type": "object",
  "required": ["schema_version", "operation", "selector", "values", "expected_before_raw_hex"],
  "properties": {"schema_version": {"const": 1}},
  "oneOf": [
    {"properties": {"schema_version": {"const": 1}, "operation": {"const": "WriteTimer"}, "selector": {"type": "object", "required": ["channel", "instance", "weekday"], "properties": {"channel": {"enum": ["ventilation", "noise-reduction", "tariff", "dhw", "circulation", "zone-cooling", "zone-heating"]}, "instance": {"type": "integer", "minimum": 0, "maximum": 255}, "weekday": {"type": "integer", "minimum": 0, "maximum": 6}}, "additionalProperties": false}, "values": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"anyOf": [{"type": "null"}, {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 0, "maximum": 255}}]}}, "expected_before_raw_hex": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string", "pattern": "^[0-9A-Fa-f]{14}$"}}}, "required": ["operation", "selector", "values", "expected_before_raw_hex"], "additionalProperties": false},
    {"properties": {"schema_version": {"const": 1}, "operation": {"enum": ["SetEvent", "SetEventSetPoint"]}, "selector": {"type": "object", "required": ["profile", "instance", "address", "weekday_code"], "properties": {"profile": {"enum": ["system", "dhw", "zone"]}, "instance": {"type": "integer", "minimum": 0, "maximum": 255}, "address": {"type": "integer", "minimum": 0, "maximum": 255}, "weekday_code": {"type": "integer", "minimum": 0, "maximum": 255}}, "additionalProperties": false}, "values": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"type": "integer", "minimum": 0, "maximum": 255}}, "expected_before_raw_hex": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "pattern": "^[0-9A-Fa-f]{16}$"}}}, "required": ["operation", "selector", "values", "expected_before_raw_hex"], "additionalProperties": false}
  ]
}
