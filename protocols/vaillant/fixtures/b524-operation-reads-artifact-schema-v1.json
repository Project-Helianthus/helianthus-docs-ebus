{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "B524 operation-read additions to artifact schema 2.3",
  "type": "object",
  "required": ["schema_version", "b524_operation_reads_schema_version", "b524_operation_reads"],
  "properties": {
    "schema_version": {"const": "2.3"},
    "b524_operation_reads_schema_version": {"const": 1},
    "b524_operation_reads": {"type": "array", "items": {"$ref": "#/$defs/observation"}}
  },
  "additionalProperties": true,
  "$defs": {
    "u8": {"type": "integer", "minimum": 0, "maximum": 255},
    "hex": {"type": "string", "pattern": "^(?:[0-9A-Fa-f]{2})*$"},
    "raw_selector": {"type": "object", "required": ["system_type", "instance", "address"], "properties": {"system_type": {"$ref": "#/$defs/u8"}, "instance": {"$ref": "#/$defs/u8"}, "address": {"$ref": "#/$defs/u8"}, "weekday": {"$ref": "#/$defs/u8"}, "weekday_code": {"$ref": "#/$defs/u8"}}, "additionalProperties": false},
    "pair_context": {"type": "object", "required": ["profile", "instance", "address", "weekday_code"], "properties": {"profile": {"enum": ["system", "dhw", "zone"]}, "instance": {"$ref": "#/$defs/u8"}, "address": {"$ref": "#/$defs/u8"}, "weekday_code": {"$ref": "#/$defs/u8"}}, "additionalProperties": false},
    "common": {"type": "object", "required": ["operation", "opcode_hex", "selector", "request_payload_hex", "response_raw_hex", "response_state", "decoded", "decode_qualification", "selector_correlation", "request_attempts"], "properties": {"request_payload_hex": {"$ref": "#/$defs/hex"}, "response_raw_hex": {"anyOf": [{"$ref": "#/$defs/hex"}, {"type": "null"}]}, "response_state": {"enum": ["value", "empty", "nack", "timeout", "transport_error", "malformed", "unattempted"]}, "decoded": {"anyOf": [{"type": "object"}, {"type": "null"}]}, "decode_qualification": {"enum": ["profile_vrc700", "schema_unqualified"]}, "selector_correlation": {"const": "request_context"}, "request_attempts": {"type": "integer", "minimum": 0}, "error": {"type": "string", "minLength": 1}, "raw_selector": {"$ref": "#/$defs/raw_selector"}, "pair_context": {"$ref": "#/$defs/pair_context"}, "trace_seq": {"type": "integer", "minimum": 0}}, "allOf": [{"if": {"properties": {"response_state": {"const": "unattempted"}}}, "then": {"required": ["error"], "properties": {"request_attempts": {"const": 0}}}}, {"if": {"properties": {"response_state": {"const": "transport_error"}}}, "then": {"required": ["error"], "properties": {"request_attempts": {"minimum": 1}}}}, {"if": {"required": ["raw_selector"]}, "then": {"properties": {"decoded": {"const": null}, "decode_qualification": {"const": "schema_unqualified"}}}}]},
    "timer_selector": {"type": "object", "required": ["channel", "instance", "weekday"], "properties": {"channel": {"enum": ["ventilation", "noise-reduction", "tariff", "dhw", "circulation", "zone-cooling", "zone-heating"]}, "instance": {"$ref": "#/$defs/u8"}, "weekday": {"type": "integer", "minimum": 0, "maximum": 6}}, "additionalProperties": false},
    "event_selector": {"type": "object", "required": ["profile", "instance", "address", "weekday_code"], "properties": {"profile": {"enum": ["system", "dhw", "zone"]}, "instance": {"$ref": "#/$defs/u8"}, "address": {"$ref": "#/$defs/u8"}, "weekday_code": {"$ref": "#/$defs/u8"}}, "additionalProperties": false},
    "vr91_decoded": {"type": "object", "required": ["binding_zone", "special_function_status", "heating_operating_mode", "cooling_operating_mode", "status_info", "frost_protection", "heating_temperature_raw", "cooling_temperature_raw", "raw_hex"], "properties": {"binding_zone": {"$ref": "#/$defs/u8"}, "special_function_status": {"$ref": "#/$defs/u8"}, "heating_operating_mode": {"$ref": "#/$defs/u8"}, "cooling_operating_mode": {"$ref": "#/$defs/u8"}, "status_info": {"$ref": "#/$defs/u8"}, "frost_protection": {"$ref": "#/$defs/u8"}, "heating_temperature_raw": {"$ref": "#/$defs/u8"}, "cooling_temperature_raw": {"$ref": "#/$defs/u8"}, "raw_hex": {"$ref": "#/$defs/hex"}}, "additionalProperties": false},
    "observation": {"oneOf": [
      {"allOf": [{"$ref": "#/$defs/common"}, {"properties": {"operation": {"const": "ReadTimer"}, "opcode_hex": {"const": "0x03"}, "selector": {"oneOf": [{"$ref": "#/$defs/timer_selector"}, {"type": "object", "maxProperties": 0}]}, "decoded": {"anyOf": [{"type": "object", "required": ["parameter_config"]}, {"type": "null"}]}}, "allOf": [{"if": {"properties": {"selector": {"type": "object", "maxProperties": 0}}}, "then": {"required": ["raw_selector"], "properties": {"raw_selector": {"required": ["weekday"]}}}}]}], "unevaluatedProperties": false},
      {"allOf": [{"$ref": "#/$defs/common"}, {"properties": {"operation": {"const": "ReadVR91"}, "opcode_hex": {"const": "0x08"}, "selector": {"type": "object", "maxProperties": 0}, "decoded": {"anyOf": [{"$ref": "#/$defs/vr91_decoded"}, {"type": "null"}]}}, "not": {"required": ["raw_selector"]}}], "unevaluatedProperties": false},
      {"allOf": [{"$ref": "#/$defs/common"}, {"properties": {"operation": {"enum": ["GetEvent", "GetEventSetPoint"]}, "opcode_hex": {"enum": ["0x09", "0x0B"]}, "decode_qualification": {"const": "schema_unqualified"}, "selector": {"oneOf": [{"$ref": "#/$defs/event_selector"}, {"type": "object", "maxProperties": 0}]}}, "allOf": [{"if": {"properties": {"operation": {"const": "GetEvent"}}}, "then": {"properties": {"opcode_hex": {"const": "0x09"}}}}, {"if": {"properties": {"operation": {"const": "GetEventSetPoint"}}}, "then": {"properties": {"opcode_hex": {"const": "0x0B"}}}}, {"if": {"properties": {"selector": {"type": "object", "maxProperties": 0}}}, "then": {"required": ["raw_selector"], "properties": {"raw_selector": {"anyOf": [{"required": ["weekday"]}, {"required": ["weekday_code"]}]}}}}]}], "unevaluatedProperties": false}
    ]}
  }
}
