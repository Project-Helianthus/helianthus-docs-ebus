{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "B524 explicit operation-read plan v1",
  "type": "object",
  "required": ["schema_version", "requests"],
  "properties": {
    "schema_version": {"const": 1},
    "requests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/request"}}
  },
  "additionalProperties": false,
  "$defs": {
    "u8": {"type": "integer", "minimum": 0, "maximum": 255},
    "request": {
      "oneOf": [
        {"type": "object", "required": ["operation", "channel", "instance", "weekday"], "properties": {"operation": {"const": "ReadTimer"}, "channel": {"enum": ["ventilation", "noise-reduction", "tariff", "dhw", "circulation", "zone-cooling", "zone-heating"]}, "instance": {"$ref": "#/$defs/u8"}, "weekday": {"type": "integer", "minimum": 0, "maximum": 6}}, "additionalProperties": false},
        {"type": "object", "required": ["operation"], "properties": {"operation": {"const": "ReadVR91"}}, "additionalProperties": false},
        {"type": "object", "required": ["operation", "profile", "instance", "address", "weekday_code"], "properties": {"operation": {"enum": ["GetEvent", "GetEventSetPoint"]}, "profile": {"enum": ["system", "dhw", "zone"]}, "instance": {"$ref": "#/$defs/u8"}, "address": {"$ref": "#/$defs/u8"}, "weekday_code": {"$ref": "#/$defs/u8"}}, "additionalProperties": false}
      ]
    }
  }
}
