{
  "schema": "helianthus.public-graphql-m2m.contract",
  "schema_version": 1,
  "contract_id": "PUBLIC_GRAPHQL_M2M_V1",
  "status": "CANDIDATE_PRE_IMPLEMENTATION",
  "route": "/graphql/m2m/v1",
  "source_contract": "helianthus.canonical-pv/v1",
  "source_owner": "helianthus-ebusreg",
  "operation": "m2mCurrentSnapshot",
  "dedicated_tls_listener": true,
  "query_only": true,
  "single_asset": true,
  "max_facts_per_snapshot": 256,
  "max_provenance_per_snapshot": 256,
  "max_capabilities_per_snapshot": 1,
  "catalog_fact_ids": ["pv.ac.power.active", "pv.ac.power.apparent", "pv.ac.power.reactive", "pv.ac.power_factor", "pv.ac.frequency", "pv.ac.current", "pv.ac.voltage.line_to_neutral", "pv.ac.voltage.line_to_line", "pv.energy.active_export_total", "pv.dc.current", "pv.dc.voltage", "pv.dc.power.active", "pv.dc.energy.active_total", "pv.temperature", "pv.operating.state", "pv.event.flags", "pv.rating.ac.active_power"],
  "required_fact_fields": ["fact_id", "dimensions", "value", "unit", "quality", "availability", "freshness", "receipt_monotonic_ns", "fresh_until_monotonic_ns", "retain_until_monotonic_ns", "freshness_policy", "origin_ref", "continuity"],
  "required_response_fields": ["contract_id", "canonical_contract_id", "asset_ref", "generation", "produced_at", "evaluated_monotonic_ns", "source_time_state", "facts", "capabilities", "provenance"],
  "capability_fields": ["id", "outcome"],
  "opaque_provenance_fields": ["origin_ref", "evidence_ref"],
  "contract_negotiation": {"request_field": "contractId", "accepted": ["PUBLIC_GRAPHQL_M2M_V1"], "incompatible": "FAIL_CLOSED"},
  "request_bounds": {"method": "POST", "operation_name": "M2MCurrentSnapshot", "max_body_bytes": 16384, "max_query_depth": 8, "max_selected_fields": 256, "max_concurrency_per_client": 1, "requests_per_second_per_client": 1, "burst_per_client": 2, "max_response_bytes": 1048576, "forbidden_graphql_features": ["batching", "aliases", "fragments", "directives", "introspection", "get", "subscriptions", "multiple_operations"]},
  "transport_security": {"https": "VERIFIED_SERVER_IDENTITY_REQUIRED", "client_authentication": "MTLS_PER_CLIENT_REQUIRED", "forbidden_credentials": ["cookies", "shared_credentials", "interactive_credentials"]},
  "operator_authority": ["dedicated_listener", "server_identity", "ca_and_trust_root", "client_certificate_issuance", "asset_allowlist", "rotation", "revocation"],
  "recovery": {"unknown_revoked_expired_or_lost_client_certificate": "FAIL_CLOSED", "bad_server_identity": "FAIL_CLOSED", "incompatible_contract": "FAIL_CLOSED", "retry": "BOUNDED", "after_reconnect": "FRESH_FULL_SNAPSHOT", "monotonic_times_across_restart": "NOT_COMPARABLE"},
  "error_contract": {"contract_incompatible": "CONTRACT_INCOMPATIBLE", "asset_forbidden": "ASSET_FORBIDDEN", "asset_not_found": "ASSET_NOT_FOUND", "source_unavailable": "SOURCE_UNAVAILABLE", "partial_snapshot_on_error": false, "generic_fallback": false},
  "credential_rotation": {"maximum_simultaneously_valid_certificates_per_principal": 2, "sequence": ["issue_replacement", "verify_replacement", "revoke_predecessor"], "revocation_checked_before_asset_authorization": true, "lost_credential_recovery": "OPERATOR_ISSUED_REPLACEMENT_ONLY"},
  "forbidden_surface": ["raw_registers", "source_shadow", "endpoints", "mutations", "subscriptions", "history", "unbounded_lists", "generic_graphql_fallback"],
  "compatibility": {"catalog_closed": true, "additive_or_breaking_change": "SUCCESSOR_CONTRACT_ID_REQUIRED"},
  "private_binding_ingress": "ONLY_PUBLIC_SEMANTIC_INGRESS"
}
