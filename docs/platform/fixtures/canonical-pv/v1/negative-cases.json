{
  "fixture_contract": "helianthus.canonical-pv.negative-cases/v1",
  "base": "golden-three-phase.json",
  "cases": [
    {
      "id": "unknown_fact_field",
      "mutation": {"op": "add", "path": "/facts/0/unexpected", "value": true},
      "expected_rule": "schema_closed"
    },
    {
      "id": "provenance_endpoint_leak",
      "mutation": {"op": "add", "path": "/source_provenance/endpoint", "value": "example.invalid:502"},
      "expected_rule": "schema_closed"
    },
    {
      "id": "guessed_rollover_without_evidence",
      "mutation": {
        "op": "replace",
        "path": "/facts/8/continuity",
        "value": {"state": "ROLLOVER", "delta": "1", "modulus": null, "evidence_ref": null}
      },
      "expected_rule": "continuity_evidence"
    },
    {
      "id": "satisfied_capability_missing_required_fact",
      "mutation": {"op": "remove", "path": "/facts/7"},
      "expected_rule": "capability_completeness"
    },
    {
      "id": "invalid_phase_dimension",
      "mutation": {"op": "replace", "path": "/facts/2/dimensions", "value": {"phase": "L4"}},
      "expected_rule": "dimension_domain"
    },
    {
      "id": "unknown_canonical_enum_symbol",
      "mutation": {"op": "replace", "path": "/facts/9/value/symbol", "value": "SOURCE_VENDOR_MAGIC"},
      "expected_rule": "value_domain"
    },
    {
      "id": "invalid_source_admission",
      "mutation": {"op": "replace", "path": "/source_provenance/source_validity", "value": "invalid"},
      "expected_rule": "source_admission"
    },
    {
      "id": "unknown_fact_id",
      "mutation": {"op": "replace", "path": "/facts/0/fact_id", "value": "pv.unlisted.metric"},
      "expected_rule": "catalog_closure"
    },
    {
      "id": "frequency_wrong_unit",
      "mutation": {"op": "replace", "path": "/facts/1/unit", "value": "W"},
      "expected_rule": "catalog_closure"
    },
    {
      "id": "frequency_wrong_value_kind",
      "mutation": {"op": "replace", "path": "/facts/1/value", "value": {"kind": "enum", "symbol": "UNKNOWN"}},
      "expected_rule": "catalog_closure"
    },
    {
      "id": "negative_contiguous_delta",
      "mutation": {
        "op": "replace",
        "path": "/facts/8/continuity",
        "value": {"state": "CONTIGUOUS", "delta": {"kind": "decimal", "coefficient": "-1", "scale": 0}, "modulus": null, "evidence_ref": null}
      },
      "expected_rule": "continuity_evidence"
    },
    {
      "id": "mapped_projection_without_fact",
      "mutation": {"op": "replace", "path": "/projection_report/0/fact_id", "value": null},
      "expected_rule": "projection_binding"
    },
    {
      "id": "mapped_projection_to_absent_fact",
      "mutation": {"op": "replace", "path": "/projection_report/0/fact_id", "value": "pv.rating.ac.active_power"},
      "expected_rule": "projection_binding"
    },
    {
      "id": "projection_source_endpoint_leak",
      "mutation": {"op": "replace", "path": "/projection_report/0/source_ref", "value": "tcp://example.invalid:502/holding-register/40000"},
      "expected_rule": "projection_redaction"
    },
    {
      "id": "mapped_projection_ambiguous_phase",
      "mutation": {"op": "replace", "path": "/projection_report/0/fact_id", "value": "pv.ac.current"},
      "expected_rule": "projection_binding"
    },
    {
      "id": "provenance_private_ip_in_source_protocol",
      "mutation": {"op": "replace", "path": "/source_provenance/source_protocol", "value": "192.168.100.21"},
      "expected_rule": "provenance_redaction"
    },
    {
      "id": "source_profile_version_mismatch",
      "mutation": {"op": "replace", "path": "/source_provenance/source_profile_id", "value": "sunspec.unregistered@2.0.0"},
      "expected_rule": "provenance_binding"
    },
    {
      "id": "invalid_available_expired_pair",
      "mutation": {"op": "replace", "path": "/facts/0/freshness", "value": "EXPIRED"},
      "expected_rule": "lifecycle_state_pair"
    },
    {
      "id": "satisfied_capability_with_unsupported_fact",
      "mutation": [
        {"op": "replace", "path": "/facts/0/availability", "value": "UNSUPPORTED"},
        {"op": "replace", "path": "/facts/0/freshness", "value": "EXPIRED"}
      ],
      "expected_rule": "capability_support_state"
    },
    {
      "id": "duplicate_capability_id",
      "mutation": {"op": "add", "path": "/capabilities/-", "value": {"id": "helianthus.pv.inverter.three_phase.telemetry.v1", "outcome": "NOT_SATISFIED"}},
      "expected_rule": "capability_uniqueness"
    },
    {
      "id": "input_id_over_64_characters",
      "mutation": {"op": "replace", "path": "/facts/10/dimensions/input_id", "value": "mppt-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"},
      "expected_rule": "dimension_domain"
    },
    {
      "id": "conflicting_projection_outcome_for_same_output",
      "mutation": {"op": "replace", "path": "/projection_report/1/requested_output_ref", "value": "sha256:bc3ae450a43db0d91f3f77c91bfe382c33d6b8983623321ce52de247ecc08a56"},
      "expected_rule": "projection_identity"
    },
    {
      "id": "fresh_fact_evaluated_after_retention",
      "mutation": {"op": "replace", "path": "/evaluated_monotonic_ns", "value": 90000000000000},
      "expected_rule": "freshness_evaluation"
    },
    {
      "id": "rollover_with_zero_modulus",
      "mutation": {
        "op": "replace",
        "path": "/facts/8/continuity",
        "value": {
          "state": "ROLLOVER",
          "delta": {"kind": "decimal", "coefficient": "1", "scale": 0},
          "modulus": {"kind": "decimal", "coefficient": "0", "scale": 0},
          "evidence_ref": "sha256:15ad3760510a1ba7f17a7a6e5f9af36b8e7ec2e256f2b30772270b0c44f39b04"
        }
      },
      "expected_rule": "continuity_evidence"
    }
  ]
}
