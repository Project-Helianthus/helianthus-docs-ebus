{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.helianthus.local/schemas/leaf-promotion-lock-result-v1.schema.json",
  "title": "Helianthus Leaf Promotion Lock Result V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "schema_version",
    "profile",
    "export_tier",
    "replay_tool",
    "replay_version",
    "counts",
    "dossier_count",
    "m9_consumer_gate",
    "verdict",
    "result_hash"
  ],
  "properties": {
    "contract": {"const": "helianthus.platform.leaf-promotion-lock-result.v1"},
    "schema_version": {"const": 1},
    "profile": {
      "enum": ["SYNTHETIC_CONFORMANCE", "CAPTURED_RUNTIME_ZERO_PROMOTION"]
    },
    "export_tier": {"const": "PUBLIC_REDACTED"},
    "dossier_id": {"$ref": "#/$defs/TokenV1"},
    "dossier_hash": {"$ref": "#/$defs/DigestV1"},
    "source_bindings": {"$ref": "#/$defs/PublicSourceBindingsV1"},
    "replay_tool": {"const": "leaf-promotion-replay"},
    "replay_version": {"const": 1},
    "counts": {"$ref": "#/$defs/CountsV1"},
    "dossier_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 64
    },
    "leaves": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/SyntheticLeafV1"}
    },
    "assessments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/PublicAssessmentV1"}
    },
    "m9_consumer_gate": {
      "enum": ["BLOCKED_ZERO_PROMOTED_LEAVES", "READY_FOR_M9"]
    },
    "verdict": {"enum": ["VALID_ZERO_PROMOTION", "VALID_PROMOTION_LOCK"]},
    "result_hash": {"$ref": "#/$defs/DigestV1"}
  },
  "allOf": [
    {
      "if": {"properties": {"profile": {"const": "SYNTHETIC_CONFORMANCE"}}},
      "then": {
        "required": ["dossier_id", "dossier_hash", "leaves"],
        "properties": {
          "dossier_count": {"const": 1}
        },
        "not": {
          "anyOf": [
            {"required": ["source_bindings"]},
            {"required": ["assessments"]}
          ]
        }
      }
    },
    {
      "if": {
        "properties": {"profile": {"const": "CAPTURED_RUNTIME_ZERO_PROMOTION"}}
      },
      "then": {
        "required": ["source_bindings", "assessments"],
        "properties": {
          "dossier_count": {"const": 0},
          "m9_consumer_gate": {"const": "BLOCKED_ZERO_PROMOTED_LEAVES"},
          "verdict": {"const": "VALID_ZERO_PROMOTION"},
          "counts": {
            "properties": {"promoted": {"const": 0}}
          }
        },
        "not": {
          "anyOf": [
            {"required": ["dossier_id"]},
            {"required": ["dossier_hash"]},
            {"required": ["leaves"]}
          ]
        }
      }
    }
  ],
  "$defs": {
    "TokenV1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[\\x20-\\x7e]+$"
    },
    "DigestV1": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "CommitV1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "CandidateIdV1": {
      "type": "string",
      "pattern": "^m7-candidate-[0-9]{4}$"
    },
    "GraphIdV1": {
      "type": "string",
      "pattern": "^dcfgv1:sha256:[0-9a-f]{64}$"
    },
    "ReplayIdV1": {
      "type": "string",
      "pattern": "^dcfrv1:sha256:[0-9a-f]{64}$"
    },
    "StatusProjectionIdV1": {
      "type": "string",
      "pattern": "^dcfpsv1:sha256:[0-9a-f]{64}$"
    },
    "CoexistenceEvidenceIdV1": {
      "type": "string",
      "pattern": "^mrcv1:sha256:[0-9a-f]{64}$"
    },
    "CoexistenceReportIdV1": {
      "type": "string",
      "pattern": "^mrcrv1:sha256:[0-9a-f]{64}$"
    },
    "NullableTerminalV1": {
      "oneOf": [
        {"enum": ["NO_SIGNAL", "CLOUD_ONLY", "CONFLICT", "NOT_TESTED"]},
        {"type": "null"}
      ]
    },
    "CountsV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "promoted", "withheld"],
      "properties": {
        "total": {"type": "integer", "minimum": 1, "maximum": 64},
        "promoted": {"type": "integer", "minimum": 0, "maximum": 64},
        "withheld": {"type": "integer", "minimum": 0, "maximum": 64}
      }
    },
    "SyntheticLeafV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["leaf_id", "semantic_path", "decision", "terminal_state", "visibility"],
      "properties": {
        "leaf_id": {"$ref": "#/$defs/TokenV1"},
        "semantic_path": {
          "type": "string",
          "minLength": 2,
          "maxLength": 512,
          "pattern": "^/[a-z0-9_]+(?:/[a-z0-9_]+)*$"
        },
        "decision": {"enum": ["PROMOTED", "WITHHELD"]},
        "terminal_state": {"$ref": "#/$defs/NullableTerminalV1"},
        "visibility": {"enum": ["RAW_DEBUG_ONLY", "LOCKED_NOT_EXPOSED"]}
      }
    },
    "PublicSourceBindingsV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "m7_gateway_source_commit",
        "m7_docs_source_commit",
        "m7_graph_id",
        "m7_graph_hash",
        "m7_replay_id",
        "m7_replay_hash",
        "m7_status_projection_id",
        "m7_status_projection_hash",
        "m8_gateway_source_commit",
        "m8_docs_source_commit",
        "m8_evidence_id",
        "m8_evidence_hash",
        "m8_report_id",
        "m8_report_hash",
        "coexistence_verdict"
      ],
      "properties": {
        "m7_gateway_source_commit": {"$ref": "#/$defs/CommitV1"},
        "m7_docs_source_commit": {"$ref": "#/$defs/CommitV1"},
        "m7_graph_id": {"$ref": "#/$defs/GraphIdV1"},
        "m7_graph_hash": {"$ref": "#/$defs/DigestV1"},
        "m7_replay_id": {"$ref": "#/$defs/ReplayIdV1"},
        "m7_replay_hash": {"$ref": "#/$defs/DigestV1"},
        "m7_status_projection_id": {"$ref": "#/$defs/StatusProjectionIdV1"},
        "m7_status_projection_hash": {"$ref": "#/$defs/DigestV1"},
        "m8_gateway_source_commit": {"$ref": "#/$defs/CommitV1"},
        "m8_docs_source_commit": {"$ref": "#/$defs/CommitV1"},
        "m8_evidence_id": {"$ref": "#/$defs/CoexistenceEvidenceIdV1"},
        "m8_evidence_hash": {"$ref": "#/$defs/DigestV1"},
        "m8_report_id": {"$ref": "#/$defs/CoexistenceReportIdV1"},
        "m8_report_hash": {"$ref": "#/$defs/DigestV1"},
        "coexistence_verdict": {"const": "PASS"}
      }
    },
    "RetestV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "required_source_kinds", "minimum_new_samples"],
      "properties": {
        "trigger": {
          "enum": [
            "NEW_SYNCHRONIZED_BUNDLE",
            "SOURCE_RECOVERED",
            "IDENTITY_CONFIRMED",
            "COMPARATOR_REVISED"
          ]
        },
        "required_source_kinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"enum": ["EBUS", "EEBUS", "CLOUD_APP"]}
        },
        "minimum_new_samples": {"type": "integer", "minimum": 1, "maximum": 1024}
      }
    },
    "PublicAssessmentV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "fact_hash",
        "source_status",
        "terminal_state",
        "decision",
        "withholding_reasons",
        "retest_trigger"
      ],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/CandidateIdV1"},
        "fact_hash": {"$ref": "#/$defs/DigestV1"},
        "source_status": {"enum": ["RAW_ONLY", "WITHHELD"]},
        "terminal_state": {"$ref": "#/$defs/NullableTerminalV1"},
        "decision": {"const": "WITHHELD"},
        "withholding_reasons": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "SOURCE_STATUS_RAW_ONLY",
              "SOURCE_STATUS_WITHHELD",
              "EXACT_EBUS_IDENTITY_MISSING",
              "EXACT_EBUS_IDENTITY_INELIGIBLE",
              "EXACT_EEBUS_PATH_MISSING",
              "COMPARATOR_NOT_MATCHED",
              "CAPTURED_EVIDENCE_INELIGIBLE",
              "COEXISTENCE_PROOF_MISSING"
            ]
          }
        },
        "retest_trigger": {"$ref": "#/$defs/RetestV1"}
      }
    }
  }
}
