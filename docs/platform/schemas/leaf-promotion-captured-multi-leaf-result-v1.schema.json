{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://docs.helianthus.local/schemas/leaf-promotion-captured-multi-leaf-result-v1.schema.json",
  "type":"object","additionalProperties":false,
  "required":["contract","schema_version","profile","evidence_mode","export_tier","provenance","source_bindings","counts","candidate_results","m9_consumer_gate","verdict","result_hash"],
  "properties":{
    "contract":{"const":"helianthus.platform.leaf-promotion-captured-multi-leaf-result.v1"},
    "schema_version":{"const":1},
    "profile":{"const":"CAPTURED_RUNTIME_MULTI_LEAF_V1"},
    "evidence_mode":{"enum":["SANITIZED_CONFORMANCE","LIVE_CAPTURE"]},
    "export_tier":{"const":"PUBLIC_REDACTED"},
    "provenance":{"type":"object","additionalProperties":false,"required":["class","binding_hash"],"properties":{"class":{"enum":["SANITIZED_CONFORMANCE","LIVE_CAPTURE"]},"binding_hash":{"$ref":"#/$defs/Digest"}}},
    "source_bindings":{"type":"object","additionalProperties":false,"required":["registry_sha256","docs_eebus_commit","m7_graph_hash","m7_graph_bytes_hash","m7_replay_hash","m7_replay_bytes_hash","m7_status_hash","m7_status_bytes_hash","m8_evidence_hash","m8_evidence_bytes_hash","m8_report_hash","m8_report_bytes_hash","replay_hash","campaign_hash","private_campaign_bytes_hash"],"properties":{"registry_sha256":{"$ref":"#/$defs/Digest"},"docs_eebus_commit":{"const":"657a36d07e52570326384b757a5382a6789f641b"},"m7_graph_hash":{"$ref":"#/$defs/Digest"},"m7_graph_bytes_hash":{"$ref":"#/$defs/Digest"},"m7_replay_hash":{"$ref":"#/$defs/Digest"},"m7_replay_bytes_hash":{"$ref":"#/$defs/Digest"},"m7_status_hash":{"$ref":"#/$defs/Digest"},"m7_status_bytes_hash":{"$ref":"#/$defs/Digest"},"m8_evidence_hash":{"$ref":"#/$defs/Digest"},"m8_evidence_bytes_hash":{"$ref":"#/$defs/Digest"},"m8_report_hash":{"$ref":"#/$defs/Digest"},"m8_report_bytes_hash":{"$ref":"#/$defs/Digest"},"replay_hash":{"$ref":"#/$defs/Digest"},"campaign_hash":{"$ref":"#/$defs/Digest"},"private_campaign_bytes_hash":{"$ref":"#/$defs/Digest"}}},
    "counts":{"type":"object","additionalProperties":false,"required":["total","promoted","withheld"],"properties":{"total":{"const":18},"promoted":{"type":"integer","minimum":0,"maximum":11},"withheld":{"type":"integer","minimum":7,"maximum":18}}},
    "candidate_results":{"type":"array","minItems":18,"maxItems":18,"items":{"$ref":"#/$defs/CandidateResult"}},
    "m9_consumer_gate":{"enum":["BLOCKED_CONFORMANCE_ONLY","BLOCKED_ZERO_PROMOTED_LEAVES","READY_FOR_M9_PLANNING"]},
    "verdict":{"enum":["VALID_SUBSET_PROMOTION_CONFORMANCE","VALID_ZERO_PROMOTION","VALID_PROMOTION_LOCK"]},
    "result_hash":{"$ref":"#/$defs/Digest"}
  },
  "$defs":{
    "Digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "CandidateResult":{"type":"object","additionalProperties":false,"required":["candidate_id","fact_hash","decision","terminal_state","visibility","dossier_hash","window_outcomes"],"properties":{"candidate_id":{"type":"string","pattern":"^m7-candidate-[0-9]{4}$"},"fact_hash":{"$ref":"#/$defs/Digest"},"decision":{"enum":["PROMOTED","WITHHELD"]},"terminal_state":{"oneOf":[{"enum":["CLOUD_ONLY","NOT_TESTED","MISSING","NOT_COMPARABLE","IDENTITY_MISMATCH","GENERATION_CHANGED","INVALID","STALE","CONFLICT","MISMATCH"]},{"type":"null"}]},"visibility":{"enum":["LOCKED_NOT_EXPOSED","RAW_DEBUG_ONLY"]},"dossier_hash":{"oneOf":[{"$ref":"#/$defs/Digest"},{"type":"null"}]},"window_outcomes":{"type":"array","minItems":0,"maxItems":2,"items":{"enum":["MATCH","MISMATCH","MISSING","NOT_COMPARABLE","IDENTITY_MISMATCH","GENERATION_CHANGED","INVALID","STALE","CONFLICT","NOT_EVALUATED"]}}}}
  }
}
