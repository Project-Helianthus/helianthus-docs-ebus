    "EBusIdentity":{"type":"object","additionalProperties":false,"required":["family","target_address","source_address","opcode","group","instance","register","register_id","selector_hash"],"properties":{"family":{"enum":["B509","B524","B555"]},"target_address":{"type":["integer","null"],"minimum":0,"maximum":255},"source_address":{"type":["integer","null"],"minimum":0,"maximum":255},"opcode":{"type":["integer","null"],"minimum":0,"maximum":255},"group":{"type":["integer","null"],"minimum":0,"maximum":255},"instance":{"type":["integer","null"],"minimum":0,"maximum":255},"register":{"type":["integer","null"],"minimum":0,"maximum":65535},"register_id":{"type":["integer","null"],"minimum":0,"maximum":65535},"selector_hash":{"$ref":"#/$defs/Digest"}}},
