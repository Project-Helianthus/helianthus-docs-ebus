{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.helianthus.local/schemas/canonical-pv-source-registry-bindings-v1.schema.json",
  "title": "Helianthus Canonical PV Source Registry Bindings V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "entries"],
  "properties": {
    "contract": {"const": "helianthus.source-registry-bindings/v1"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/EntryV1"}
    }
  },
  "$defs": {
    "SourceTokenV1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9._@-]*$"
    },
    "VersionTokenV1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9][0-9A-Za-z._-]*$"
    },
    "DigestV1": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "EntryV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_protocol", "source_profile_id", "source_profile_version", "source_validity", "registry_ref"],
      "properties": {
        "source_protocol": {"$ref": "#/$defs/SourceTokenV1"},
        "source_profile_id": {"$ref": "#/$defs/SourceTokenV1"},
        "source_profile_version": {"$ref": "#/$defs/VersionTokenV1"},
        "source_validity": {"const": "terminal_verified"},
        "registry_ref": {"$ref": "#/$defs/DigestV1"}
      }
    }
  }
}
